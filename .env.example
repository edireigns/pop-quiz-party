# ---------------------------------------------------------------------------
# Pop Quiz Party — environment variables
# Copy to .env.local for local development. NEVER commit real values.
# ---------------------------------------------------------------------------

# Public URL of the site (used for QR codes and join links). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres connection string (server only).
# Supabase: Project Settings -> Database -> Connection string -> "Transaction pooler" (port 6543).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/popquiz

# Supabase Realtime (optional locally; required in production on Vercel).
# If these are blank, the app falls back to a built-in Server-Sent Events channel
# that only works when running a single server process (fine for local dev/tests).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used to broadcast "state changed" pings. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Secret that Vercel Cron sends to /api/cron/cleanup (any long random string).
CRON_SECRET=change-me-to-a-long-random-string
